# Copy to .env.local and fill in. Never commit .env.local.

# Appwrite (required)
NEXT_PUBLIC_ENDPOINT=https://cloud.appwrite.io/v1
PROJECT_ID=
API_KEY=
DATABASE_ID=
PATIENT_COLLECTION_ID=
DOCTOR_COLLECTION_ID=
APPOINTMENT_COLLECTION_ID=
NEXT_PUBLIC_BUCKET_ID=

# Admin dashboard (required for /admin). Both stay on the server.
# ADMIN_PASSKEY is the 6-digit code entered in the passkey dialog.
ADMIN_PASSKEY=
# Signs the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Sentry (optional). Nothing is reported while the DSN is empty.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Links to the companion apps in the navbar (optional; hidden when empty)
NEXT_PUBLIC_FORUM_URL=
NEXT_PUBLIC_CHATBOT_URL=
